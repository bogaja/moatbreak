       "de": ["\\bsynchronisier", "\\bdaten (sind |waren )?(weg|verloren|gel(ö|oe)scht)\\b", "\\bverschwunden\\b", "\\bdatenverlust\\b", "\\bsicherung\\b", "\\bdoppelt\\b"]}},
