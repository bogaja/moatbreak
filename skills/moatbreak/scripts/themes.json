{
  "_about": "Themes reviews.py sorts feedback into. Patterns are Python regular expressions, matched case-insensitively against the review text, grouped by language (add a key such as \"tr\" or \"fr\" for more). kind is complaint (something users hate) or request (something users want that is missing). Labels can be a string or {\"en\": ..., \"de\": ...}. Edit freely and add the category's own words (for a booking app: double booking, time zone, no-show; for a shop: the brand's product names).",
  "request_patterns": {
      "en": [
          "\\bi wish\\b",
          "\\bplease add\\b",
          "\\bwould be (nice|great|good|helpful)\\b",
          "\\bwould love\\b",
          "\\bneeds? (a|an|the|to|more)\\b",
          "\\bno way to\\b",
          "\\bthere'?s no (way|option)\\b",
          "\\b(can'?t|cannot|unable to) (even )?(add|change|edit|set|choose|export|import|customi[sz]e|connect|undo|delete|turn off)\\b",
          "\\b(missing|lacks|lacking)\\b",
          "\\bdoesn'?t (have|support|let|allow)\\b",
          "\\bif only\\b",
          "\\bfeature request\\b",
          "\\bwhy (can'?t|isn'?t|doesn'?t)\\b"
      ],
      "de": [
          "\\bich w(ü|ue)nschte\\b",
          "\\bw(ü|ue)nsche mir\\b",
          "\\bh(ä|ae)tte (gerne?|lieber)\\b",
          "\\bw(ä|ae)re (schön|schoen|toll|gut|super|klasse|praktisch|hilfreich|nett)\\b",
          "\\bbitte (f(ü|ue)gt|f(ü|ue)ge|baut|bringt|macht|erg(ä|ae)nzt)\\b",
          "\\bfehlt\\b",
          "\\bfehlen\\b",
          "\\bvermisse\\b",
          "\\bes gibt (leider )?keine (m(ö|oe)glichkeit|option|funktion)\\b",
          "\\bkeine (m(ö|oe)glichkeit|option) (zu|f(ü|ue)r)\\b",
          "\\b(kann|k(ö|oe)nnte) man (leider )?(nicht|kein)",
          "\\bman kann (leider )?(nicht|kein)",
          "\\bwarum (kann|gibt|ist|geht)\\b",
          "\\bleider (keine?) (m(ö|oe)glichkeit|option|funktion|export|schnittstelle)\\b"
      ]
  },
