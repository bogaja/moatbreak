       "de": ["\\bst(ü|ue)rzt\\b", "\\babgest(ü|ue)rzt\\b", "\\babsturz", "\\bfehler(haft)?\\b", "\\bfunktioniert (nicht|gar nicht|nicht mehr|kaum)\\b", "\\bgeht (nicht|gar nicht|nicht mehr)\\b", "\\bh(ä|ae)ngt sich auf\\b", "\\bkaputt\\b", "\\bverbuggt\\b"]}},
