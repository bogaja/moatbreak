       "de": ["\\babgebucht\\b", "\\b(r(ü|ue)ck)?erstattung\\b", "\\bk(ü|ue)ndig", "\\babo.?falle\\b", "\\bautomatisch verl(ä|ae)ngert\\b", "\\bversteckte (kosten|geb(ü|ue)hren)\\b", "\\babzocke\\b", "\\bbetrug\\b", "\\bkreditkarte\\b", "\\blastschrift\\b"]}},
    {"id": "bugs", "label": {"en": "Bugs and crashes", "de": "Fehler und Abstürze"}, "kind": "complaint",
