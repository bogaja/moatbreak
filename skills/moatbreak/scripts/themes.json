       "de": ["\\bteuer", "\\b(ü|ue)berteuert\\b", "\\bpreis", "\\babo\\b", "\\babonnement\\b", "\\bkostenpflichtig\\b", "\\bbezahlschranke\\b", "\\bpro (monat|nutzer|benutzer|lizenz|platz)\\b", "\\bkostenlose (version|variante)\\b", "\\bnicht (sein |das )?geld wert\\b", "\\bpreiserh(ö|oe)hung\\b", "\\bkosten\\b"]}},
    {"id": "billing", "label": {"en": "Payments, cancelling and refunds", "de": "Zahlung, Kündigung und Erstattung"}, "kind": "complaint",
     "patterns": {
