       "de": ["\\banmeld(en|ung)\\b", "\\beinloggen\\b", "\\bpasswort\\b", "\\bgesperrt\\b", "\\bverifizier", "\\bkonto (l(ö|oe)schen|gel(ö|oe)scht)\\b", "\\bzwei.?faktor\\b"]}},
    {"id": "notifications", "label": {"en": "Notifications and spam", "de": "Benachrichtigungen und Spam"}, "kind": "complaint",
